# Copy to .env and fill in. .env is gitignored -- never commit real values.
# GET /health/config reports which of these are present on a running
# instance (booleans only, never the values themselves).

# --- Database (Neon) ---
# Pooled connection, used at runtime.
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
# Unpooled connection, used only by migrations.
DIRECT_URL="postgresql://user:password@host/db?sslmode=require"

# --- Redis (Upstash) ---
# Two jobs: 30-day URL dedupe keys, and the daily Gemini call counter.
# The app degrades rather than fails if these are wrong -- quota checks
# fail open and dedupe falls back to the database.
UPSTASH_REDIS_URL="https://your-db.upstash.io"
UPSTASH_REDIS_TOKEN=""

# --- AI ---
# Google AI Studio key. Used for summarisation, MAJOR classification and
# the on-demand "Read more" breakdown.
GEMINI_API_KEY=""

# --- Auth ---
# Signs our own session JWT. Any long random string; unrelated to Google.
JWT_SECRET=""
# Google Cloud Console -> Credentials -> OAuth client (Web application).
# Public by design, but kept here so it's one place to rotate. The
# deployed web origin must be listed under Authorized JavaScript origins.
GOOGLE_CLIENT_ID=""

# --- Mail (Brevo) ---
# Brevo -> SMTP & API -> API keys. Must be an API key (xkeysib-...), not
# an SMTP key (xsmtpsib-...): mail goes out over the HTTP API, because
# Render blocks outbound SMTP ports on free web services.
BREVO_API_KEY=""
# The from address. Must be verified as a sender in Brevo or every send
# is rejected.
GMAIL_USER="you@example.com"

# --- URLs ---
# Where verification and reset links send people, and the origin allowed
# to call this API. No trailing slashes. Comma-separated list for CORS.
WEB_APP_URL="http://localhost:4200"
CORS_ORIGIN="http://localhost:4200"

# --- Ingestion ---
# Shared secret for the ingestion trigger: GET /ingest?key=<this>
INGEST_SECRET=""
